# PureNest Cleaning Co. — environment configuration
#
# Copy this file to `.env.local` (local) or configure these values in
# your hosting provider's environment settings. Never commit a real
# `.env` file or real credentials.

# Resend API key (required for quote-request email delivery)
RESEND_API_KEY=

# Recipient of new quote-request emails (PureNest inbox)
QUOTE_TO_EMAIL=

# Verified sender address for quote-request emails
QUOTE_FROM_EMAIL=
